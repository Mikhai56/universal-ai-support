# Получите токен у @BotFather и храните его только в переменной окружения
TELEGRAM_BOT_TOKEN=

# Ваш числовой Telegram chat ID для уведомлений и команд /queue
ADMIN_CHAT_ID=

# Ограничения против злоупотреблений и срок хранения обращений
MAX_MESSAGE_CHARS=4096
RATE_LIMIT_SECONDS=1.0
RETENTION_DAYS=90

# Ваши пути при локальном запуске (необязательно)
DB_PATH=
KB_PATH=
